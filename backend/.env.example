# Development environment configuration
# Copy this file to .env and fill in your values
# For production, set ENVIRONMENT=production and provide all required variables

# Environment (development or production)
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost/tg_tools

# Telegram API
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# OpenAI (optional)
OPENAI_API_KEY=sk-your_openai_key_here

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Security - Generated automatically in development, REQUIRED in production
# To generate: python -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_in_production_only

# CORS - For production, set your domain
PRODUCTION_DOMAIN=https://yourdomain.com

# Database credentials (if using environment variables instead of DATABASE_URL)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=tg_tools
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_ACCOUNT=1.0  # seconds between API calls per account

# Human Behavior Simulation
HUMAN_BEHAVIOR_ENABLED=true
DEFAULT_TIMEZONE=Asia/Kolkata
SLEEP_START_HOUR=23  # 11 PM
SLEEP_END_HOUR=7     # 7 AM
ENABLE_BREAKS=true

# Health Monitoring
HEALTH_MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=300  # 5 minutes
DAILY_MESSAGE_LIMIT=50     # Per account
DAILY_GROUP_JOIN_LIMIT=10  # Per account
DAILY_API_CALL_LIMIT=500   # Per account

# Health Score Thresholds
HEALTH_SCORE_WARNING=80
HEALTH_SCORE_RESTRICTED=50
HEALTH_SCORE_BANNED=20

# Admin Alerts (Optional - for Telegram notifications)
ADMIN_BOT_TOKEN=  # Your Telegram bot token for alerts
ADMIN_TELEGRAM_ID=  # Your Telegram user ID for receiving alerts

# Account Selection
MIN_HEALTH_SCORE_FOR_JOBS=70.0
MAX_ACCOUNTS_PER_JOB=10
