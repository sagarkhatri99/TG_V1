# Development environment configuration
# Copy this file to .env and fill in your values
# For production, set ENVIRONMENT=production and provide all required variables

# Environment (development or production)
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost/tg_tools
# SQLite fallback (development only)
# DATABASE_URL=sqlite:///./tg_tools.db

# Telegram API
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# OpenAI (optional)
OPENAI_API_KEY=sk-your_openai_key_here

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Security - Generated automatically in development, REQUIRED in production
# To generate: python -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_in_production_only

# CORS - For production, set your domain
PRODUCTION_DOMAIN=https://yourdomain.com

# Database credentials (if using environment variables instead of DATABASE_URL)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=tg_tools
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
